{
  "schema": 1,
  "extensionId": "org.fleet.rclone",
  "pages": [
    {
      "id": "rclone",
      "title": "Rclone",
      "route": "/ext/org.fleet.rclone/rclone"
    }
  ],
  "actions": [
    {
      "id": "scan-now",
      "label": "Scan completions now",
      "target": "global",
      "primary": true
    },
    {
      "id": "list-jobs",
      "label": "List running transfers",
      "target": "global"
    },
    {
      "id": "list-journal",
      "label": "Show journal",
      "target": "global"
    },
    {
      "id": "clear-journal",
      "label": "Clear journal",
      "target": "global",
      "danger": true
    }
  ],
  "panels": [
    {
      "id": "rclone",
      "title": "Rclone",
      "placement": "settings"
    }
  ],
  "forms": [
    {
      "id": "rclone-settings",
      "title": "Rclone — remotes and rules",
      "fields": [
        {
          "name": "enabled",
          "label": "Enabled",
          "kind": "boolean",
          "help": "Master switch for this worker."
        },
        {
          "name": "intervalSec",
          "label": "Poll interval (seconds)",
          "kind": "number",
          "required": true,
          "help": "How often the worker wakes up.",
          "placeholder": "60",
          "advanced": true
        },
        {
          "name": "rcloneBin",
          "label": "rclone binary override (empty = tools.rclone / PATH)",
          "kind": "text"
        },
        {
          "name": "rcloneResolved",
          "label": "Resolved rclone path (hint after save)",
          "kind": "text",
          "advanced": true
        },
        {
          "name": "remotesAllowText",
          "label": "Allowlisted remotes",
          "kind": "textarea",
          "required": true,
          "help": "One remote name per line.",
          "rows": 6,
          "advanced": true
        },
        {
          "name": "rulesText",
          "label": "Transfer rules (key=value — Expert)",
          "kind": "textarea",
          "required": true,
          "advanced": true,
          "help": "Also editable with the visual builder above. action=copy|move remote=NAME dest={label}/{name} [label=…]",
          "rows": 10
        },
        {
          "name": "deleteLocalAfterVerify",
          "label": "After copy: rclone check then delete local (default off)",
          "kind": "boolean",
          "advanced": true
        }
      ],
      "loadMethod": "ext.rclone.getSettings",
      "submitMethod": "ext.rclone.saveSettings",
      "description": "Copy finished torrents to an rclone remote. Build transfer rules visually (or Expert)."
    },
    {
      "id": "rclone-cancel",
      "title": "Cancel transfer",
      "fields": [
        {
          "name": "cancelJobId",
          "label": "Job id",
          "kind": "text",
          "required": true,
          "help": "From List running transfers."
        }
      ],
      "description": "Adjust Cancel transfer — essentials first, extras under More options."
    }
  ]
}
